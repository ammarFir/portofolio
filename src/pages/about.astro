---
import Layout from "../layouts/Layout.astro";

const skills = [
  {
    name: "Laravel",
    icon: "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/laravel/laravel-original.svg",
    level: 70,
    projects: [
      "Marlapor (Sistem Pengaduan Keursakan Jalan dan Jembatan",
      "Fitur Tracking Web Bakti Bersama",
      "CarCare (Web Jasa Layanan Pembersihan Mobil)",
      "Photobooth Web",
      "Tiktok Downloader    ",
    ],
  },

  {
    name: "Java",
    icon: "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/java/java-original.svg",
    level: 70,
    projects: [
      "Kantin Polhas",
      "App Pencatatan Keuangan Pribadi",
      "App Pencatatan Keuangan Usaha Ayam Potong",
      "Crud Shoppe Cloning",
    ],
  },

  {
    name: "MySQL",
    icon: "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/mysql/mysql-original.svg",
    level: 60,
    projects: [
      "Fitur Tracking App Si Azis",
      "Kantin Polhas",
      "CarCare (Web Jasa Layanan Pembersihan Mobil)",
      "Photobooth Web",
      "Tiktok Downloader    ",
    ],
  },

  {
    name: "XML",
    icon: "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/xml/xml-original.svg",
    level: 60,
    projects: [
      "Fitur Tracking App Si Azis",
      "Kantin Polhas",
      "App Pencatatan Keuangan Pribadi",
      "App Pencatatan Keuangan Usaha Ayam Potong",
      "Crud Shopee Cloning",
    ],
  },

  {
    name: "Kotlin",
    icon: "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/kotlin/kotlin-original.svg",
    level: 70,
    projects: ["Fitur Tracking App Si Azis"],
  },

  {
    name: "PHP",
    icon: "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/php/php-original.svg",
    level: 65,
    projects: ["Backend Tracking Si Azis", "Backend Kantin Polhas"],
  },

  {
    name: "SQLite",
    icon: "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/sqlite/sqlite-original.svg",
    level: 60,
    projects: [
      "App Pencatatan Keuangan Pribadi",
      "App Pencatatan Keuangan Usaha Ayam Potong",
    ],
  },
  {
    name: "Linux",
    icon: "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/linux/linux-original.svg",
    level: 60,
    projects: ["Pengoperasian Kali Linux"],
  },

  {
    name: "VB",
    icon: "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/visualbasic/visualbasic-original.svg",
    level: 60,
    projects: ["Sistem Penghitungan Nilai Mahasiswa"],
  },
  {
    name: "Python",
    icon: "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/python/python-original.svg",
    level: 60,
    projects: ["Tiktok Account Scrapper"],
  },
  {
    name: "Astro",
    icon: "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/astro/astro-original.svg",
    level: 60,
    projects: ["Web Portofolio"],
  },
  {
    name: "Firebase",
    icon: "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/firebase/firebase-original.svg",
    level: 60,
    projects: ["Crud Shopee Cloning "],
  },
  {
    name: "CodeIgniter",
    icon: "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/codeigniter/codeigniter-plain.svg",
    level: 60,
    projects: ["Web Koperasi Banjarmasin Timur"],
  },
];
---

<Layout>
  <div class="about-wrapper">
    <section class="story-terminal terminal-card">
      <div class="terminal-header">
        <span class="dot red"></span>
        <span class="dot yellow"></span>
        <span class="dot green"></span>
        <span class="terminal-title">whoami.sh</span>
      </div>
      <div class="terminal-body">
        <p class="prompt-line"><span class="prompt">$</span> whoami</p>
        <p class="story">
          Saya tertarik pada dunia teknologi, khususnya programming dalam
          pengembangan aplikasi dan website. Saya senang mempelajari teknologi
          baru, memecahkan masalah, dan memanfaatkan AI sebagai alat bantu untuk
          mempercepat proses belajar maupun development.
        </p>
      </div>
    </section>

    <div class="skills-grid">
      {
        skills.map((skill) => (
          <div class="terminal-card">
            <div class="terminal-header">
              <span class="dot red" />
              <span class="dot yellow" />
              <span class="dot green" />
              <span class="terminal-title">{skill.name.toLowerCase()}.sh</span>
            </div>
            <div class="terminal-body">
              <div class="skill-top">
                <img src={skill.icon} alt={skill.name} />
                <span class="skill-name">{skill.name}</span>
              </div>

              <div class="skill-bar-track">
                <div class="skill-bar-fill" style={`width: ${skill.level}%`} />
              </div>
              <p class="skill-percent">{skill.level}%</p>

              <p class="prompt-line">
                <span class="prompt">$</span> ls ./projects
              </p>
              <ul class="project-list">
                {skill.projects.map((p) => (
                  <li>{p}</li>
                ))}
              </ul>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</Layout>

<style>
  .about-wrapper {
    position: relative;
    z-index: 1;
    max-width: 1000px;
    margin: 0 auto;
    padding: 3rem 1.5rem 6rem;
  }

  .story-terminal {
    width: 100%;
    margin-bottom: 0.5rem;
  }

  .story {
    color: #cccccc;
    line-height: 1.7;
    margin: 0;
  }

  .skills-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 1.5rem;
  }

  .terminal-card {
    border: 1px solid #333333;
    border-radius: 0.5rem;
    overflow: hidden;
    background-color: #111111;
  }

  .terminal-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.6rem 0.9rem;
    background-color: #1c1c1c;
    border-bottom: 1px solid #333333;
  }

  .dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
  }

  .dot.red {
    background-color: #ff5f56;
  }
  .dot.yellow {
    background-color: #ffbd2e;
  }
  .dot.green {
    background-color: #27c93f;
  }

  .terminal-title {
    margin-left: 0.4rem;
    font-size: 0.7rem;
    color: #888888;
  }

  .terminal-body {
    padding: 1rem 1.1rem;
  }

  .skill-top {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 0.8rem;
  }

  .skill-top img {
    width: 28px;
    height: 28px;
  }

  .skill-name {
    font-size: 0.95rem;
    color: #e5e5e5;
  }

  .skill-bar-track {
    width: 100%;
    height: 6px;
    background-color: #262626;
    border-radius: 3px;
    overflow: hidden;
  }

  .skill-bar-fill {
    height: 100%;
    background-color: #00ff41;
    border-radius: 3px;
  }

  .skill-percent {
    font-size: 0.7rem;
    color: #00ff41;
    margin: 0.3rem 0 1rem 0;
  }

  .prompt-line {
    font-size: 0.75rem;
    color: #888888;
    margin: 0 0 0.4rem 0;
  }

  .prompt {
    color: #00ff41;
    margin-right: 0.4rem;
  }

  .project-list {
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 0.75rem;
    color: #cccccc;
  }

  .project-list li {
    padding: 0.15rem 0 0.15rem 1rem;
    text-indent: -1rem;
  }

  .project-list li::before {
    content: "- ";
    color: #555555;
  }
</style>
