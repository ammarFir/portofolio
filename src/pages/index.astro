---
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <section class="hero">
    <h1>MUHAMMAD AMMAR FIRDAUS</h1>
    <p class="role">Newbie Programmer</p>
    <p class="tagline">tertangkap kau suki 🤓</p>
    <a href="/projects" class="cta-button">View Projects</a>
  </section>
</Layout>

<style>
  .hero {
    min-height: calc(100vh - 5rem);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: 0.75rem;
    position: relative;
    z-index: 1;
  }

  h1 {
    font-size: 6.5rem;
    font-weight: 700;
    color: #e5e5e5;
    margin: 0;
  }

  .role {
    font-size: 2.1rem;
    color: #00ff41;
    margin: 0;
  }

  .tagline {
    font-size: 2rem;
    color: #999999;
    margin: 0 0 1rem 0;
  }

  .cta-button {
    display: inline-block;
    padding: 0.75rem 1.75rem;
    border: 1px solid #00ff41;
    border-radius: 0.4rem;
    color: #00ff41;
    text-decoration: none;
    font-family: "JetBrains Mono", monospace;
    transition:
      background-color 0.1s ease,
      color 0.1s ease;
  }

  .cta-button:hover {
    background-color: #00ff41;
    color: #0d0d0d;
  }
</style>
