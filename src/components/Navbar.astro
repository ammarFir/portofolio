<nav>
  <a href="/" class="nav-link"><span data-text="Home">Home</span></a>
  <a href="/about" class="nav-link"><span data-text="About">About</span></a>
  <a href="/projects" class="nav-link"
    ><span data-text="Projects">Projects</span></a
  >
  <a href="/contact" class="nav-link"
    ><span data-text="Contact">Contact</span></a
  >
</nav>

<style>
  nav {
    display: flex;
    gap: 2rem;
    padding: 1rem 2rem;
    font-family: "JetBrains Mono", monospace;
    background-color: #181818;
    position: fixed;
    top: 1.5rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 10;
    border-radius: 0.5rem;
    border: 1px solid #333333;
  }
  .nav-link {
    position: relative;
    display: inline-block;
    overflow: hidden;
    height: 1.2em;
    text-decoration: none;
    color: #e5e5e5;
  }

  .nav-link span {
    position: relative;
    display: block;
  }

  :global(.nav-link .letter) {
    display: inline-block;
    position: relative;
    transition: transform 0.3s ease;
  }

  :global(.nav-link .letter .top),
  :global(.nav-link .letter .bottom) {
    display: block;
  }

  :global(.nav-link .letter .bottom) {
    position: absolute;
    top: 100%;
    left: 0;
  }

  .nav-link:hover :global(.letter) {
    transform: translateY(-100%);
  }
</style>

<script>
  const navLinks = document.querySelectorAll<HTMLElement>(".nav-link span");

  navLinks.forEach((span) => {
    const text = span.dataset.text || "";
    span.innerHTML = "";

    text.split("").forEach((char, index) => {
      const letter = document.createElement("span");
      letter.className = "letter";
      letter.style.transitionDelay = `${index * 15}ms`;

      const top = document.createElement("span");
      top.className = "top";
      top.textContent = char;

      const bottom = document.createElement("span");
      bottom.className = "bottom";
      bottom.textContent = char;

      letter.appendChild(top);
      letter.appendChild(bottom);
      span.appendChild(letter);
    });
  });
</script>
